# Backend listens here. Use a different port from the frontend's default 3000.
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tukio:tukio_local_password@localhost:5432/tukio?schema=public
DIRECT_URL=postgresql://tukio:tukio_local_password@localhost:5432/tukio?schema=public
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h
PAYMENT_WEBHOOK_SECRET=replace-this-with-a-random-webhook-secret
TICKET_SIGNING_SECRET=replace-this-with-a-different-random-ticket-secret

# Optional demo events seed. Set both values to enable `npm run db:seed`.
# SEED_ORGANIZER_EMAIL=demo-organizer@example.test
# SEED_ORGANIZER_PASSWORD=change-this-to-a-long-dev-password

# Optional: set these to enable NestJS Observe telemetry.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
